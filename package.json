{
  "name": "dsh-apophis",
  "displayName": "DeepSeek Harness",
  "description": "Chat with a DeepSeek Harness agent over the Agent Client Protocol (ACP) inside VS Code.",
  "version": "0.1.0",
  "publisher": "deepseek-harness",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pokerface-1224/dsh-apophis.git"
  },
  "bugs": {
    "url": "https://github.com/pokerface-1224/dsh-apophis/issues"
  },
  "homepage": "https://github.com/pokerface-1224/dsh-apophis#readme",
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "agent",
    "acp",
    "coding-agent"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:dsh.startChat"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dsh.startChat",
        "title": "Start Chat",
        "category": "DeepSeek Harness",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "dsh.newChat",
        "title": "New Chat",
        "category": "DeepSeek Harness",
        "icon": "$(add)"
      },
      {
        "command": "dsh.restartChat",
        "title": "Restart Agent",
        "category": "DeepSeek Harness",
        "icon": "$(debug-restart)"
      },
      {
        "command": "dsh.stopChat",
        "title": "Stop Agent",
        "category": "DeepSeek Harness",
        "icon": "$(debug-stop)"
      }
    ],
    "configuration": {
      "title": "DeepSeek Harness",
      "properties": {
        "dsh.server.command": {
          "type": "string",
          "default": "node",
          "markdownDescription": "Executable used to launch the dsh ACP server."
        },
        "dsh.server.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Arguments for the ACP server. Leave empty to auto-build the default tsx launcher from `#dsh.server.repoPath#`."
        },
        "dsh.server.repoPath": {
          "type": "string",
          "default": "D:\\deepseek-harness",
          "markdownDescription": "Path to a `deepseek-harness` checkout. Used to build the default launch command and as the server process working directory."
        },
        "dsh.server.cwd": {
          "type": "string",
          "default": "",
          "markdownDescription": "Working directory for the ACP server process. Defaults to `#dsh.server.repoPath#` so the tsx loader resolves."
        },
        "dsh.server.useShell": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Launch the server through a shell. Enable when the command is a `.cmd`/`.bat` (e.g. `pnpm.cmd`)."
        },
        "dsh.server.env": {
          "type": "object",
          "default": {},
          "markdownDescription": "Extra environment variables for the server, e.g. `{\"DEEPSEEK_API_KEY\": \"sk-…\"}` and `{\"DEEPSEEK_BASE_URL\": \"https://…\"}`.",
          "additionalProperties": {
            "type": "string"
          }
        },
        "dsh.permission": {
          "type": "string",
          "enum": [
            "ask",
            "allow",
            "reject"
          ],
          "default": "ask",
          "markdownDescription": "How to answer the agent's sandbox permission requests: `ask` (show a prompt), `allow` (approve once), `reject` (decline)."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.25.1",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0"
  }
}
